# Copy this file to .env and fill it with the values from Firebase/Cloudinary.
# Do not commit the resulting .env file.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Solo para cargar el catálogo ficticio de demostración.
# Usa una cuenta Firebase de prueba con rol "tendero"; no uses tu cuenta personal.
SEED_TENDERO_EMAIL=
SEED_TENDERO_PASSWORD=
# Imagen de respaldo para productos. Debe ser una URL segura servida por Cloudinary.
SEED_PRODUCT_IMAGE_URL=
# Opcionales: si se dejan vacías, se utiliza la imagen de respaldo anterior.
SEED_IMAGE_FRUTAS_URL=
SEED_IMAGE_VERDURAS_URL=
SEED_IMAGE_TUBERCULOS_URL=
SEED_IMAGE_HORTALIZAS_URL=
SEED_IMAGE_ABARROTES_URL=
SEED_IMAGE_CARNES_URL=
