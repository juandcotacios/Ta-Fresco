{
  "expo": {
    "name": "Ta Fresco",
    "slug": "ta-fresco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ta-fresco-logo.png",
    "scheme": "tafresco",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.juandcotacios.tafresco",
      "supportsTablet": true
    },
    "android": {
      "package": "com.juandcotacios.tafresco",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#25C950",
        "foregroundImage": "./assets/images/ta-fresco-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ta-fresco-logo.png"
    },
    "plugins": [
      "expo-router",
      ["react-native-nitro-google-signin", {}],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ta-fresco-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4FFF5",
          "dark": {
            "backgroundColor": "#101B12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b260e06-9b0d-4f32-bbc3-5e8d6ee9baf1"
      }
    }
  }
}
